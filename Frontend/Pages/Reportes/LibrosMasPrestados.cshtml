@page "/Reportes/LibrosMasPrestados"
@model Frontend.Pages.Reportes.LibrosMasPrestadosModel

@{
    ViewData["Title"] = "Libros Más Prestados";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/prestamo.css" />
}

<div class="prestamo-page">
    <div class="prestamo-shell">

        <div class="page-header">
            <div class="titulo-logo">
                <div class="page-icon-shell">
                    <img src="~/assets/icons/library_books_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.svg"
                         class="icono-header"
                         alt="Libros más prestados" />
                </div>
                <div>
                    <h1>Reporte - Libros Más Prestados</h1>
                    <p class="page-subtitle">
                        Consulta los libros con mayor cantidad de préstamos registrados en la biblioteca.
                    </p>
                </div>
            </div>
        </div>

        <div class="prestamo-panel prestamo-panel-compact">
            <form method="get" class="mb-4 d-flex gap-2 align-items-center flex-wrap">

                <label class="field-label">Fecha Inicio</label>
                <input type="date" asp-for="FechaInicio" class="input-form" style="width:auto;" />

                <label class="field-label">Fecha Fin</label>
                <input type="date" asp-for="FechaFin" class="input-form" style="width:auto;" />

                <button type="submit" class="btn btn-primary" style="font-weight:600; font-size:15px;">
                    Generar Reporte
                </button>

                <button type="button" class="btn btn-danger" style="font-weight:600; font-size:15px;" onclick="descargarPDF()">
                    Descargar PDF
                </button>

                <button type="button" class="btn btn-success" style="font-weight:600; font-size:15px;" onclick="descargarExcel()">
                    Descargar Excel
                </button>

            </form>
        </div>

        <div id="reporte-container" style="background:#ffffff; color:#000000; padding:24px; border-radius:14px; position:relative; overflow:hidden; box-shadow:0 18px 45px rgba(0,0,0,.35);">

            <div id="reporte-content" style="position:relative; z-index:2;">

                <header style="display:flex; align-items:center; justify-content:space-between; border-bottom:2px solid #222; padding-bottom:14px; margin-bottom:18px;">
                    <div>
                        <h2 style="margin:0; font-weight:800;">Reporte de Libros Más Prestados</h2>
                        <p style="margin:4px 0 0;">Biblioteca StarBook</p>
                    </div>

                    <img src="/assets/images/blackLogoR.png" alt="Logo" style="height:90px;" />
                </header>

                <section style="margin-bottom:18px; background:#ffffff; padding:12px 14px; border-radius:8px; border:1px solid #d1d5db;">
                    <strong>Filtros aplicados:</strong>
                    <span>
                        Fecha inicio: @(Model.FechaInicio?.ToString("dd/MM/yyyy") ?? "Todos") |
                        Fecha fin: @(Model.FechaFin?.ToString("dd/MM/yyyy") ?? "Todos")
                    </span>
                </section>

                <table class="table table-bordered" style="background:#ffffff;">

                    <thead>
                        <tr>
                            <th>Libro</th>
                            <th>Cantidad de préstamos</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.Reporte)
                        {
                            <tr>
                                <td>@item.TituloLibro</td>
                                <td>@item.CantidadPrestamos</td>
                            </tr>
                        }
                    </tbody>

                </table>

                <div style="height:350px; max-width:900px; margin:30px auto; background:#ffffff; border-radius:10px; padding:14px; border:1px solid #d1d5db;">
                    <canvas id="graficoLibros"></canvas>
                </div>

                <footer style="border-top:2px solid #222; margin-top:18px; padding-top:12px; display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap;">
                    <span>Total de libros listados: @Model.Reporte.Count</span>
                    <span>Total de préstamos: @Model.Reporte.Sum(x => x.CantidadPrestamos)</span>
                </footer>

                <section style="border-top:1px solid #444; margin-top:18px; padding-top:14px; display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; font-size:14px;">
                    <span><strong>Fecha:</strong> @DateTime.Now.ToString("dd/MM/yyyy")</span>
                    <span><strong>Hora:</strong> @DateTime.Now.ToString("HH:mm")</span>
                </section>

            </div>

        </div>

    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        const labels = [
            @Html.Raw(string.Join(",", Model.Reporte.Select(x => $"'{x.TituloLibro.Replace("'", "\\'")}'")))
        ];

        const data = [
            @string.Join(",", Model.Reporte.Select(x => x.CantidadPrestamos))
        ];

        new Chart(document.getElementById('graficoLibros'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Cantidad de préstamos',
                    data: data,
                    backgroundColor: 'rgba(54, 162, 235, 0.65)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        async function descargarPDF() {
            const { jsPDF } = window.jspdf;
            const elemento = document.getElementById('reporte-container');

            const fondoOriginal = elemento.style.background;
            const sombraOriginal = elemento.style.boxShadow;

            elemento.style.background = '#ffffff';
            elemento.style.boxShadow = 'none';

            const canvas = await html2canvas(elemento, {
                scale: 2,
                backgroundColor: '#ffffff',
                useCORS: true
            });

            elemento.style.background = fondoOriginal;
            elemento.style.boxShadow = sombraOriginal;

            const imgData = canvas.toDataURL('image/png');
            const pdf = new jsPDF('p', 'mm', 'a4');

            const margen = 10;
            const anchoPdf = 210 - (margen * 2);
            const altoPdf = (canvas.height * anchoPdf) / canvas.width;

            pdf.addImage(imgData, 'PNG', margen, margen, anchoPdf, altoPdf);
            pdf.save('LibrosMasPrestados.pdf');
        }

        function descargarExcel() {
            const datos = [
                ['Libro', 'Cantidad de préstamos']
            ];

            @foreach (var item in Model.Reporte)
            {
                @:datos.push(['@item.TituloLibro.Replace("'", "\\'")', @item.CantidadPrestamos]);
            }

            const hoja = XLSX.utils.aoa_to_sheet(datos);
            hoja['!cols'] = [{ wch: 45 }, { wch: 25 }];

            const libro = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(libro, hoja, "Libros más prestados");

            XLSX.writeFile(libro, "LibrosMasPrestados.xlsx");
        }
    </script>
}